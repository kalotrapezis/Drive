{
  "name": "local-drive-desktop",
  "version": "0.6.0-beta.35",
  "description": "Tetra desktop app",
  "main": "main.js",
  "scripts": {
    "dev": "vite & sleep 2; VITE_DEV_URL=http://localhost:5199 electron .; kill %1",
    "start": "node scripts/copy-skill.js && vite build && electron .",
    "check": "tsc -p .",
    "test": "node --test src/*.test.ts test/*.test.js",
    "dist": "node scripts/copy-skill.js && vite build && electron-builder --linux deb && scripts/bundle-tools.sh && electron-builder --linux AppImage --config electron-builder.appimage.cjs"
  },
  "author": "Theologos Kalotrapezis <kalotrapezis@gmail.com>",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "heic-decode": "^2.1.0",
    "imapflow": "^2.10.0",
    "libphonenumber-js": "^1.13.15",
    "libsodium-wrappers-sumo": "^0.8.4",
    "mailparser": "^3.14.1",
    "maplibre-gl": "^6.10.0",
    "nodemailer": "^10.3.1",
    "onnxruntime-node": "^1.30.0",
    "pmtiles": "^4.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^6.0.1"
  },
  "productName": "Tetra",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "build": {
    "appId": "com.kalotrapezis.drive.desktop",
    "productName": "Tetra",
    "files": [
      "main.js",
      "preload.js",
      "i18n.js",
      "locales/*.json",
      "library.js",
      "files.js",
      "faces.js",
      "sync.js",
      "models/*.txt",
      "documents.js",
      "data/places.tsv.gz",
      "editor.js",
      "vault.js",
      "places.js",
      "analyzer.js",
      "folders.js",
      "drives.js",
      "home.js",
      "system.js",
      "cleaner.js",
      "thumbs.js",
      "file-kinds.json",
      "purgatory.js",
      "timer.js",
      "datacount.js",
      "maps.js",
      "router.js",
      "client.js",
      "reset.js",
      "callaudio.js",
      "mapbuild.js",
      "maps-tools/*.py",
      "history.js",
      "notes.js",
      "calendar.js",
      "contacts.js",
      "contactfaces.js",
      "calls.js",
      "bubble.html",
      "bubble-preload.js",
      "skills/**",
      "importer.js",
      "assistant.js",
      "mail.js",
      "models/*.onnx",
      "models/tessdata/*.traineddata",
      "dist/**",
      "public/icon.png",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_cuda.so",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_tensorrt.so",
      "!node_modules/tesseract.js-core/*.wasm.js",
      "!node_modules/tesseract.js-core/tesseract-core-lstm.{js,wasm}",
      "!node_modules/tesseract.js-core/tesseract-core-simd-lstm.{js,wasm}"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/onnxruntime-node/**"
    ],
    "linux": {
      "category": "Graphics",
      "icon": "public/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Theologos Kalotrapezis <kalotrapezis@gmail.com>"
    },
    "directories": {
      "output": "release"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "openjdk-17-jre-headless | java17-runtime-headless",
        "python3-pyosmium"
      ]
    }
  },
  "homepage": "https://github.com/kalotrapezis"
}
